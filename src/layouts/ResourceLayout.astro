---
import type { Resource } from '../utils/resources';
import { labelAudience, labelDifficulty, relatedResources } from '../utils/resources';
import { getCategory } from '../config/taxonomies';
import MainLayout from './MainLayout.astro';
import Breadcrumbs from '../components/navigation/Breadcrumbs.astro';
import DownloadButtons from '../components/resources/DownloadButtons.astro';
import ResourceGrid from '../components/resources/ResourceGrid.astro';
interface Props { resource: Resource; allResources: Resource[] }
const { resource, allResources } = Astro.props;
const category = getCategory(resource.data.category);
const subcategory = category?.subcategories?.find((item) => item.slug === resource.data.subcategory);
const related = relatedResources(resource, allResources, 4);
const moreCategory = allResources.filter((item) => item.id !== resource.id && item.data.category === resource.data.category && !related.some((relatedItem) => relatedItem.id === item.id)).slice(0, 4);
const other = allResources.filter((item) => item.id !== resource.id && !related.some((relatedItem) => relatedItem.id === item.id) && !moreCategory.some((categoryItem) => categoryItem.id === item.id)).slice(0, 4);
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'CreativeWork', name: resource.data.title,
  description: resource.data.description, image: new URL(resource.data.image, Astro.site ?? Astro.url.origin).href,
  url: Astro.url.href, isAccessibleForFree: true, datePublished: resource.data.date.toISOString(),
};
---
<MainLayout title={resource.data.title} description={resource.data.description} image={resource.data.image} type="article" jsonLd={jsonLd}>
  <div class="container">
    <Breadcrumbs items={[
      { label: 'Inicio', href: '/' }, { label: 'Mandalas', href: '/mandalas/' },
      ...(category ? [{ label: category.name, href: `/mandalas/${category.slug}/` }] : []),
      ...(subcategory ? [{ label: subcategory.name, href: `/mandalas/${category?.slug}/${subcategory.slug}/` }] : []),
      { label: resource.data.title },
    ]} />
    <article class="resource-detail">
      <div class="resource-preview"><img src={resource.data.image} alt={`${resource.data.title} para imprimir y colorear`} width="1200" height="1200" /></div>
      <div class="resource-content">
        <span class="eyebrow">Mandala gratuito</span>
        <h1>{resource.data.title}</h1>
        <p class="lead">{resource.data.description}</p>
        <DownloadButtons pdf={resource.data.downloadPdf} image={resource.data.downloadImage} title={resource.data.title} />
        <h2>Sobre este mandala</h2>
        <p>Descarga este recurso gratis, imprímelo en casa y coloréalo a tu ritmo. La vista previa es de demostración y se sustituirá por el diseño final al publicar el recurso.</p>
        <dl class="facts">
          <div><dt>Categoría</dt><dd>{category?.name ?? resource.data.category}</dd></div>
          <div><dt>Subcategoría</dt><dd>{subcategory?.name ?? 'General'}</dd></div>
          <div><dt>Dificultad</dt><dd>{labelDifficulty(resource.data.difficulty)}</dd></div>
          <div><dt>Público recomendado</dt><dd>{labelAudience(resource.data.audience)}</dd></div>
          <div><dt>Formato de impresión</dt><dd>{resource.data.printFormat}</dd></div>
          <div><dt>Precio</dt><dd>Gratis</dd></div>
        </dl>
      </div>
    </article>
  </div>
  <section class="section section-tinted related-section"><div class="container"><div class="section-header"><div><span class="eyebrow">Sigue coloreando</span><h2>Mandalas similares</h2></div></div><ResourceGrid resources={related} /></div></section>
  {category && moreCategory.length > 0 && <section class="section related-section"><div class="container"><div class="section-header"><h2>Más mandalas de {category.name}</h2><a class="text-link" href={`/mandalas/${category.slug}/`}>Ver categoría →</a></div><ResourceGrid resources={moreCategory} /></div></section>}
  {other.length > 0 && <section class="section section-tinted related-section"><div class="container"><div class="section-header"><h2>También te pueden gustar</h2></div><ResourceGrid resources={other} /></div></section>}
</MainLayout>
