---
import { withBase } from '../../utils/urls';
const links = [
  ['/', 'Inicio'], ['/mandalas/', 'Mandalas'], ['/mandalas/#categorias', 'Categorías'],
  ['/mandalas/faciles/', 'Mandalas fáciles'], ['/mandalas/ninos/', 'Niños'], ['/mandalas/adultos/', 'Adultos'],
];
const currentPath = Astro.url.pathname;
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={withBase('/')} aria-label="Manda, página de inicio">
      <span class="brand-mark" aria-hidden="true">✺</span><span>Manda</span>
    </a>
    <nav aria-label="Navegación principal">
      <details class="nav-menu">
        <summary>Menú</summary>
        <ul>
          {links.map(([href, label]) => (
            <li><a href={withBase(href)} aria-current={currentPath === withBase(href) ? 'page' : undefined}>{label}</a></li>
          ))}
        </ul>
      </details>
    </nav>
  </div>
</header>
