---
import { withBase } from '../../utils/urls';
interface Props { pdf: string; image: string; title: string }
const { pdf, image, title } = Astro.props;
---
<div class="download-actions" aria-label={`Opciones para ${title}`}>
  <a class="button button-primary" href={withBase(pdf)} download>Descargar PDF</a>
  <a class="button button-secondary" href={withBase(image)} download>Descargar imagen</a>
  <button class="button button-ghost" type="button" data-print>Imprimir</button>
</div>
<script>
  document.querySelectorAll('[data-print]').forEach((button) => button.addEventListener('click', () => window.print()));
</script>
