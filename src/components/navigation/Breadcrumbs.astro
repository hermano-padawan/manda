---
import { withBase } from '../../utils/urls';
interface Item { label: string; href?: string }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Migas de pan">
  <ol>
    {items.map((item, index) => <li>{index > 0 && <span aria-hidden="true">/</span>}{item.href ? <a href={withBase(item.href)}>{item.label}</a> : <span aria-current="page">{item.label}</span>}</li>)}
  </ol>
</nav>
